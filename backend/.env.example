PORT=4000
# Auto-detected if unset: Windows -> //./pipe/docker_engine, Linux/macOS -> /var/run/docker.sock
# Only set this if Docker Desktop uses a non-default pipe/socket on your machine.
DOCKER_SOCKET=
DB_PATH=./data/platform.db

# No auth: this runs as a single local operator account (auto-created on first boot).
# These are that account's resource limits, not per-user quotas.
DEFAULT_MAX_CONTAINERS=6
DEFAULT_CPU_LIMIT=1
DEFAULT_MEMORY_LIMIT_MB=512

# Idle reaper
IDLE_TIMEOUT_MINUTES=30
IDLE_CHECK_INTERVAL_MINUTES=5

# Reverse proxy / dynamic subdomain exposure
BASE_DOMAIN=sandboxes.local
PROXY_ENABLED=true

# Alerting (optional - webhook for CPU/memory/crash alerts)
ALERT_WEBHOOK_URL=
CPU_ALERT_THRESHOLD_PERCENT=90
MEM_ALERT_THRESHOLD_PERCENT=90

# Security hardening (optional)
# SANDBOX_RUNTIME=runsc          # gVisor runtime name, if registered with the daemon (or 'kata-runtime')
SANDBOX_RUNTIME=
SECCOMP_PROFILE_PATH=
APPARMOR_PROFILE=

# CI/CD integration - set to enable POST /api/ci/run (ephemeral job runner)
CI_API_KEY=

# Multi-host orchestration: the 'local' host is seeded automatically from DOCKER_SOCKET.
# Add more hosts at runtime via POST /api/admin/hosts (id, label, connection e.g. tcp://worker1:2376).

# Online compiler (POST /api/compiler/run)
COMPILER_TIMEOUT_MS=15000
COMPILER_CPU_LIMIT=1
COMPILER_MEMORY_LIMIT_MB=256
COMPILER_MAX_CODE_LENGTH=20000
COMPILER_RUNS_PER_HOUR=60
